{
  "name": "bc-fcm",
  "private": true,
  "version": "1.6.5",
  "type": "module",
  "description": "Liko - FCM (Friends and ChatRoom Manager) for Bondage Club",
  "scripts": {
    "predev": "node scripts/validate-icons.mjs && node scripts/copy-assets.mjs",
    "dev": "vite build && concurrently -k -n build,serve \"vite build --watch\" \"vite preview --port 5176\"",
    "preview": "vite preview --port 5176",
    "prebuild": "node scripts/validate-icons.mjs && node scripts/copy-assets.mjs",
    "build": "vite build",
    "validate:icons": "node scripts/validate-icons.mjs",
    "lint": "eslint .",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "validate:project": "node scripts/validate-project.mjs",
    "check": "npm run validate:project && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.63.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "vite": "^7.0.4"
  }
}
